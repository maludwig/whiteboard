# Copy to .env (git-ignored) and replace the change-me values with your own.
# Likewise copy docker/server.dev.example.json to docker/server.dev.json.
# Read by docker compose (the db service's env, and ${...} interpolation in
# docker-compose.yml) and, for tests run on the host, by #[sqlx::test].
#
# MARIADB_PASSWORD must match the password in docker/server.dev.json's
# database_url, and MARIADB_ROOT_PASSWORD the one in DATABASE_URL below.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=whiteboard
MARIADB_USER=whiteboard
MARIADB_PASSWORD=change-me

# Root, because #[sqlx::test] creates a throwaway database per test.
# Inside the app container, docker-compose.yml overrides this to reach `db`.
DATABASE_URL=mysql://root:change-me-root@127.0.0.1:3306/whiteboard
